{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react"],
    "paths": {
      "@mantine/core": ["../packages/@mantine/core/lib"]
    }
  },
  "include": ["./*.tsx"]
}
